def create_project(
    organization_name: str,
    project_name: str,
    description: str = ""
) -> Project:

    organization_id = uid("org")

    project = Project(
        id=uid("project"),
        organization_id=organization_id,
        name=project_name,
        description=description
    )

    site = Site(
        id=uid("site"),
        project_id=project.id,
        name="Primary Site"
    )

    project.sites[site.id] = site

    building = Building(
        id=uid("building"),
        project_id=project.id,
        site_id=site.id,
        name="Building 01"
    )

    project.buildings[
        building.id
    ] = building

    ground = Level(
        id=uid("level"),
        building_id=building.id,
        name="Ground",
        elevation=0.0,
        height=3.0
    )

    project.levels[
        ground.id
    ] = ground

    return project


