class RedlineEngine:

    def __init__(self, project: Project):
        self.project = project

    def create(
        self,
        drawing_id: str,
        author: str,
        description: str
    ) -> Redline:

        if drawing_id not in self.project.drawings:
            raise ValueError("Drawing does not exist.")

        redline = Redline(
            id=uid("redline"),
            project_id=self.project.id,
            drawing_id=drawing_id,
            author=author,
            description=description
        )

        self.project.redlines[
            redline.id
        ] = redline

        return redline

    def resolve(
        self,
        redline_id: str,
        user_id: str,
        resolution: str
    ) -> RedlineResolution:

        if redline_id not in self.project.redlines:
            raise ValueError("Redline does not exist.")

        redline = self.project.redlines[
            redline_id
        ]

        redline.status = "resolved"

        result = RedlineResolution(
            id=uid("resolution"),
            redline_id=redline_id,
            resolved_by=user_id,
            resolution=resolution,
            resolved_at=utc_now()
        )

        self.project.redline_resolutions[
            result.id
        ] = result

        return result


