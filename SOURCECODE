class DocumentationEngine:

    def __init__(self, project: Project):
        self.project = project

    def create_element_schedule(self) -> Schedule:

        rows = []

        for element in self.project.elements.values():

            geometry = None

            if element.geometry_id:
                geometry = self.project.geometries.get(
                    element.geometry_id
                )

            row = {
                "id": element.id,
                "name": element.name,
                "type": element.element_type.value,
                "level_id": element.level_id,
                "assembly_id": element.assembly_id
            }

            if geometry and geometry.bounding_box:

                row.update({
                    "width": geometry.bounding_box.width,
                    "depth": geometry.bounding_box.depth,
                    "height": geometry.bounding_box.height
                })

            rows.append(row)

        schedule = Schedule(
            id=uid("schedule"),
            project_id=self.project.id,
            name="Element Schedule",
            category="elements",
            columns=[
                "id",
                "name",
                "type",
                "level_id",
                "assembly_id",
                "width",
                "depth",
                "height"
            ],
            rows=rows
        )

        self.project.schedules[
            schedule.id
        ] = schedule

        return schedule

    def create_space_schedule(self) -> Schedule:

        rows = [
            {
                "number": s.number,
                "name": s.name,
                "level_id": s.level_id,
                "area": s.area,
                "occupancy": s.occupancy
            }
            for s in self.project.spaces.values()
        ]

        schedule = Schedule(
            id=uid("schedule"),
            project_id=self.project.id,
            name="Room / Space Schedule",
            category="spaces",
            columns=[
                "number",
                "name",
                "level_id",
                "area",
                "occupancy"
            ],
            rows=rows
        )

        self.project.schedules[
            schedule.id
        ] = schedule

        return schedule


