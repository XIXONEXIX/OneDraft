class DrawingEngine:

    def __init__(self, project: Project):
        self.project = project

    def floor_plan(
        self,
        level_id: str
    ) -> Drawing:

        if level_id not in self.project.levels:
            raise ValueError("Level does not exist.")

        level = self.project.levels[level_id]

        view = View(
            id=uid("view"),
            project_id=self.project.id,
            name=f"{level.name} Plan",
            view_type="floor_plan",
            level_id=level_id,
            scale="1:100"
        )

        self.project.views[
            view.id
        ] = view

        drawing = Drawing(
            id=uid("drawing"),
            project_id=self.project.id,
            name=f"{level.name} Floor Plan",
            drawing_type="floor_plan",
            view_ids=[view.id],
            element_ids=[
                e.id
                for e in self.project.elements.values()
                if e.level_id == level_id
            ]
        )

        self.project.drawings[
            drawing.id
        ] = drawing

        return drawing


