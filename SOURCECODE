def uid(prefix: str) -> str:
    return f"{prefix}_{uuid.uuid4().hex[:12]}"


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


class Store:
    """
    Simple JSON persistence layer.

    Production implementation should replace this with PostgreSQL,
    event storage, object storage, and transactional persistence.
    """

    def __init__(self, path: str = "onedraft_data.json"):
        self.path = Path(path)

    def save(self, project: "Project") -> None:
        payload = project.to_dict()
        self.path.write_text(
            json.dumps(payload, indent=2),
            encoding="utf-8"
        )

    def load(self) -> Optional["Project"]:
        if not self.path.exists():
            return None

        payload = json.loads(
            self.path.read_text(encoding="utf-8")
        )

        return Project.from_dict(payload)


