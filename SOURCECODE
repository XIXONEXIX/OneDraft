class ModelEngine:

    def __init__(
        self,
        project: Project,
        store: Optional[Store] = None
    ):
        self.project = project
        self.store = store

    def save(self) -> None:
        if self.store:
            self.store.save(self.project)

    def snapshot(self) -> Dict[str, Any]:
        return copy.deepcopy(
            serialize(self.project)
        )

    def create_revision(
        self,
        user_id: str,
        title: str,
        description: str
    ) -> Revision:

        self.project.current_revision_number += 1

        revision = Revision(
            id=uid("rev"),
            project_id=self.project.id,
            number=self.project.current_revision_number,
            title=title,
            description=description,
            status=RevisionStatus.DRAFT,
            created_at=utc_now(),
            created_by=user_id
        )

        self.project.revisions[revision.id] = revision

        return revision

    def create_model_version(
        self,
        user_id: str,
        description: str
    ) -> ModelVersion:

        self.project.current_model_version += 1

        version = ModelVersion(
            id=uid("model"),
            project_id=self.project.id,
            number=self.project.current_model_version,
            created_at=utc_now(),
            created_by=user_id,
            description=description,
            snapshot=self.snapshot()
        )

        self.project.model_versions[version.id] = version

        return version

    def record_change(
        self,
        user_id: str,
        revision_id: Optional[str],
        entity_type: str,
        entity_id: str,
        action: str,
        before: Optional[Any],
        after: Optional[Any]
    ) -> ChangeRecord:

        record = ChangeRecord(
            id=uid("change"),
            project_id=self.project.id,
            revision_id=revision_id,
            entity_type=entity_type,
            entity_id=entity_id,
            action=action,
            before=serialize(before),
            after=serialize(after),
            created_at=utc_now(),
            created_by=user_id
        )

        self.project.change_records[record.id] = record

        if revision_id and revision_id in self.project.revisions:
            self.project.revisions[
                revision_id
            ].change_record_ids.append(record.id)

        return record

    def add_level(
        self,
        building_id: str,
        name: str,
        elevation: float,
        height: float = 3.0,
        user_id: str = "system",
        revision_id: Optional[str] = None
    ) -> Level:

        if building_id not in self.project.buildings:
            raise ValueError("Building does not exist.")

        level = Level(
            id=uid("level"),
            building_id=building_id,
            name=name,
            elevation=elevation,
            height=height
        )

        self.project.levels[level.id] = level

        self.record_change(
            user_id,
            revision_id,
            "Level",
            level.id,
            "create",
            None,
            level
        )

        self.save()
        return level

    def add_space(
        self,
        level_id: str,
        name: str,
        number: str,
        width: float,
        depth: float,
        user_id: str = "system",
        revision_id: Optional[str] = None
    ) -> Space:

        if level_id not in self.project.levels:
            raise ValueError("Level does not exist.")

        level = self.project.levels[level_id]

        geometry = rectangle_geometry(
            0,
            0,
            width,
            depth,
            level.elevation,
            level.height
        )

        self.project.geometries[
            geometry.id
        ] = geometry

        space = Space(
            id=uid("space"),
            level_id=level_id,
            name=name,
            number=number,
            area=width * depth,
            geometry_id=geometry.id
        )

        self.project.spaces[space.id] = space

        self.record_change(
            user_id,
            revision_id,
            "Space",
            space.id,
            "create",
            None,
            space
        )

        self.save()
        return space

    def add_element(
        self,
        level_id: str,
        element_type: ElementType,
        name: str,
        x: float,
        y: float,
        width: float,
        depth: float,
        height: float = 3.0,
        user_id: str = "system",
        revision_id: Optional[str] = None
    ) -> Element:

        if level_id not in self.project.levels:
            raise ValueError("Level does not exist.")

        level = self.project.levels[level_id]

        geometry = rectangle_geometry(
            x,
            y,
            width,
            depth,
            level.elevation,
            height
        )

        self.project.geometries[
            geometry.id
        ] = geometry

        element = Element(
            id=uid("element"),
            level_id=level_id,
            element_type=element_type,
            name=name,
            geometry_id=geometry.id,
            parameters={
                "width": width,
                "depth": depth,
                "height": height
            }
        )

        self.project.elements[element.id] = element

        self.record_change(
            user_id,
            revision_id,
            "Element",
            element.id,
            "create",
            None,
            element
        )

        self.save()
        return element

    def add_relationship(
        self,
        source_id: str,
        target_id: str,
        relationship_type: RelationshipType,
        metadata: Optional[Dict[str, Any]] = None,
        user_id: str = "system",
        revision_id: Optional[str] = None
    ) -> Relationship:

        relationship = Relationship(
            id=uid("rel"),
            source_id=source_id,
            target_id=target_id,
            relationship_type=relationship_type,
            metadata=metadata or {}
        )

        self.project.relationships[
            relationship.id
        ] = relationship

        self.record_change(
            user_id,
            revision_id,
            "Relationship",
            relationship.id,
            "create",
            None,
            relationship
        )

        self.save()
        return relationship


