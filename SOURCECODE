# COMMAND INTERPRETER
# ============================================================================

class CommandInterpreter:

    def __init__(
        self,
        engine: ModelEngine,
        user_id: str = "system"
    ):
        self.engine = engine
        self.user_id = user_id

    def parse(self, text: str) -> Tuple[str, Dict[str, Any]]:

        normalized = text.strip().lower()

        patterns = [
            (
                r"create\s+(?:a\s+)?level\s+(.+?)\s+at\s+(-?\d+(?:\.\d+)?)",
                "create_level"
            ),
            (
                r"add\s+(?:a\s+)?space\s+(.+?)\s+(\d+(?:\.\d+)?)\s*x\s*(\d+(?:\.\d+)?)",
                "create_space"
            ),
            (
                r"add\s+(?:a\s+)?wall\s+(.+?)\s+(\d+(?:\.\d+)?)\s*x\s*(\d+(?:\.\d+)?)",
                "create_wall"
            ),
            (
                r"create\s+(?:a\s+)?drawing\s+(.+)",
                "create_drawing"
            ),
            (
                r"create\s+(?:a\s+)?floor\s+plan",
                "create_floor_plan"
            ),
            (
                r"run\s+(?:a\s+)?code\s+check",
                "code_check"
            ),
            (
                r"create\s+(?:a\s+)?schedule",
                "create_schedule"
            )
        ]

        for pattern, intent in patterns:
            match = re.search(pattern, normalized)

            if match:
                return intent, {
                    "groups": match.groups()
                }

        return "unknown", {}

    def execute(
        self,
        text: str,
        revision_id: Optional[str] = None
    ) -> AriaCommand:

        intent, params = self.parse(text)

        command = AriaCommand(
            id=uid("aria"),
            project_id=self.engine.project.id,
            user_id=self.user_id,
            text=text,
            intent=intent,
            parameters=params,
            status="processing",
            result=None,
            created_at=utc_now()
        )

        self.engine.project.commands[
            command.id
        ] = command

        try:

            if intent == "create_level":

                groups = params["groups"]

                if not self.engine.project.buildings:
                    raise ValueError(
                        "Create a building before creating levels."
                    )

                building = next(
                    iter(self.engine.project.buildings.values())
                )

                name = groups[0]
                elevation = float(groups[1])

                level = self.engine.add_level(
                    building.id,
                    name,
                    elevation,
                    user_id=self.user_id,
                    revision_id=revision_id
                )

                command.result = serialize(level)

            elif intent == "create_space":

                groups = params["groups"]

                if not self.engine.project.levels:
                    raise ValueError(
                        "Create a level before creating spaces."
                    )

                level = next(
                    iter(self.engine.project.levels.values())
                )

                name = groups[0]
                width = float(groups[1])
                depth = float(groups[2])

                space = self.engine.add_space(
                    level.id,
                    name,
                    str(len(self.engine.project.spaces) + 1),
                    width,
                    depth,
                    user_id=self.user_id,
                    revision_id=revision_id
                )

                command.result = serialize(space)

            elif intent == "create_wall":

                groups = params["groups"]

                if not self.engine.project.levels:
                    raise ValueError(
                        "Create a level before creating walls."
                    )

                level = next(
                    iter(self.engine.project.levels.values())
                )

                name = groups[0]
                width = float(groups[1])
                depth = float(groups[2])

                wall = self.engine.add_element(
                    level.id,
                    ElementType.WALL,
                    name,
                    0,
                    0,
                    width,
                    depth,
                    user_id=self.user_id,
                    revision_id=revision_id
                )

                command.result = serialize(wall)

            elif intent == "create_drawing":

                name = params["groups"][0]

                drawing = Drawing(
                    id=uid("drawing"),
                    project_id=self.engine.project.id,
                    name=name,
                    drawing_type="general"
                )

                self.engine.project.drawings[
                    drawing.id
                ] = drawing

                command.result = serialize(drawing)

            elif intent == "create_floor_plan":

                drawing = Drawing(
                    id=uid("drawing"),
                    project_id=self.engine.project.id,
                    name="Floor Plan",
                    drawing_type="floor_plan"
                )

                if self.engine.project.levels:

                    level = next(
                        iter(self.engine.project.levels.values())
                    )

                    view = View(
                        id=uid("view"),
                        project_id=self.engine.project.id,
                        name=f"{level.name} Floor Plan",
                        view_type="floor_plan",
                        level_id=level.id
                    )

                    self.engine.project.views[
                        view.id
                    ] = view

                    drawing.view_ids.append(view.id)

                    drawing.element_ids = [
                        e.id
                        for e in self.engine.project.elements.values()
                        if e.level_id == level.id
                    ]

                self.engine.project.drawings[
                    drawing.id
                ] = drawing

                command.result = serialize(drawing)

            elif intent == "code_check":

                results = CodeEngine(
                    self.engine.project
                ).run_all()

                command.result = {
                    "checks": [
                        serialize(c)
                        for c in results
                    ]
                }

            elif intent == "create_schedule":

                schedule = DocumentationEngine(
                    self.engine.project
                ).create_element_schedule()

                command.result = serialize(schedule)

            else:

                command.status = "rejected"
                command.result = {
                    "error": "Command intent could not be determined."
                }

                return command

            command.status = "completed"

        except Exception as exc:

            command.status = "failed"
            command.result = {
                "error": str(exc)
            }

        self.engine.save()
        return command


