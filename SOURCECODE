class ValidationEngine:

    def __init__(self, project: Project):
        self.project = project

    def validate(self) -> List[str]:

        errors: List[str] = []

        for space in self.project.spaces.values():

            if space.level_id not in self.project.levels:
                errors.append(
                    f"Space {space.id} references missing level."
                )

            if space.area < 0:
                errors.append(
                    f"Space {space.id} has negative area."
                )

        for element in self.project.elements.values():

            if element.level_id not in self.project.levels:
                errors.append(
                    f"Element {element.id} references missing level."
                )

            if element.geometry_id:
                if element.geometry_id not in self.project.geometries:
                    errors.append(
                        f"Element {element.id} references missing geometry."
                    )

        for relationship in self.project.relationships.values():

            if not self.entity_exists(
                relationship.source_id
            ):
                errors.append(
                    f"Relationship {relationship.id} has missing source."
                )

            if not self.entity_exists(
                relationship.target_id
            ):
                errors.append(
                    f"Relationship {relationship.id} has missing target."
                )

        return errors

    def entity_exists(self, entity_id: str) -> bool:

        collections = [
            self.project.requirements,
            self.project.sites,
            self.project.buildings,
            self.project.levels,
            self.project.grids,
            self.project.spaces,
            self.project.elements,
            self.project.assemblies,
            self.project.parameters,
            self.project.constraints,
            self.project.relationships
        ]

        return any(
            entity_id in collection
            for collection in collections
        )


# ============================================================================
# CODE ENGINE
# ============================================================================

class CodeEngine:

    def __init__(self, project: Project):
        self.project = project

    def evaluate(
        self,
        rule: CodeRule
    ) -> CodeCheck:

        expression = rule.expression.strip()

        passed = True
        message = "Rule passed."
        affected: List[str] = []

        if expression.startswith("MIN_SPACE_AREA"):

            try:
                minimum = float(
                    expression.split(">=")[1].strip()
                )

                for space in self.project.spaces.values():

                    if space.area < minimum:

                        passed = False
                        affected.append(space.id)

                        message = (
                            f"Space {space.number} "
                            f"has area {space.area:.2f}, "
                            f"below required minimum "
                            f"{minimum:.2f}."
                        )

            except Exception:
                passed = False
                message = "Invalid MIN_SPACE_AREA expression."

        elif expression.startswith("MIN_LEVEL_HEIGHT"):

            try:
                minimum = float(
                    expression.split(">=")[1].strip()
                )

                for level in self.project.levels.values():

                    if level.height < minimum:

                        passed = False
                        affected.append(level.id)

                        message = (
                            f"Level {level.name} has height "
                            f"{level.height:.2f}, below "
                            f"minimum {minimum:.2f}."
                        )

            except Exception:
                passed = False
                message = "Invalid MIN_LEVEL_HEIGHT expression."

        else:

            message = (
                "Rule expression registered but no evaluator "
                "has been implemented for this rule type."
            )

        check = CodeCheck(
            id=uid("check"),
            project_id=self.project.id,
            rule_id=rule.id,
            passed=passed,
            message=message,
            evaluated_at=utc_now(),
            affected_entity_ids=affected
        )

        self.project.code_checks[
            check.id
        ] = check

        return check

    def run_all(self) -> List[CodeCheck]:

        results = []

        for rule in self.project.code_rules.values():
            results.append(
                self.evaluate(rule)
            )

        return results


