def serialize(value: Any) -> Any:

    if isinstance(value, Enum):
        return value.value

    if isinstance(value, dict):
        return {
            str(k): serialize(v)
            for k, v in value.items()
        }

    if isinstance(value, list):
        return [serialize(v) for v in value]

    if hasattr(value, "__dataclass_fields__"):
        return {
            k: serialize(getattr(value, k))
            for k in value.__dataclass_fields__
        }

    return value


def point_from_dict(data: Dict[str, Any]) -> Point:
    return Point(**data)


def geometry_from_dict(data: Dict[str, Any]) -> GeometryReference:
    data = dict(data)
    data["points"] = [
        point_from_dict(p)
        for p in data.get("points", [])
    ]

    if data.get("bounding_box"):
        data["bounding_box"] = BoundingBox(
            **data["bounding_box"]
        )

    return GeometryReference(**data)


def deserialize_project(data: Dict[str, Any]) -> Project:

    p = Project(
        id=data["id"],
        organization_id=data["organization_id"],
        name=data["name"],
        description=data.get("description", "")
    )

    p.current_revision_number = data.get(
        "current_revision_number", 0
    )

    p.current_model_version = data.get(
        "current_model_version", 0
    )

    for k, v in data.get("requirements", {}).items():
        p.requirements[k] = Requirement(**v)

    for k, v in data.get("sites", {}).items():
        p.sites[k] = Site(**v)

    for k, v in data.get("buildings", {}).items():
        p.buildings[k] = Building(**v)

    for k, v in data.get("levels", {}).items():
        p.levels[k] = Level(**v)

    for k, v in data.get("grids", {}).items():
        p.grids[k] = Grid(**v)

    for k, v in data.get("spaces", {}).items():
        p.spaces[k] = Space(**v)

    for k, v in data.get("elements", {}).items():
        v = dict(v)
        v["element_type"] = ElementType(v["element_type"])
        p.elements[k] = Element(**v)

    for k, v in data.get("assemblies", {}).items():
        p.assemblies[k] = Assembly(**v)

    for k, v in data.get("parameters", {}).items():
        p.parameters[k] = Parameter(**v)

    for k, v in data.get("constraints", {}).items():
        v = dict(v)
        v["severity"] = CodeSeverity(v["severity"])
        p.constraints[k] = Constraint(**v)

    for k, v in data.get("relationships", {}).items():
        v = dict(v)
        v["relationship_type"] = RelationshipType(
            v["relationship_type"]
        )
        p.relationships[k] = Relationship(**v)

    for k, v in data.get("geometries", {}).items():
        p.geometries[k] = geometry_from_dict(v)

    for k, v in data.get("model_versions", {}).items():
        p.model_versions[k] = ModelVersion(**v)

    for k, v in data.get("revisions", {}).items():
        v = dict(v)
        v["status"] = RevisionStatus(v["status"])
        p.revisions[k] = Revision(**v)

    for k, v in data.get("change_records", {}).items():
        p.change_records[k] = ChangeRecord(**v)

    for k, v in data.get("commands", {}).items():
        p.commands[k] = AriaCommand(**v)

    for k, v in data.get("proposals", {}).items():
        p.proposals[k] = DesignProposal(**v)

    for k, v in data.get("views", {}).items():
        p.views[k] = View(**v)

    for k, v in data.get("drawings", {}).items():
        p.drawings[k] = Drawing(**v)

    for k, v in data.get("sheet_templates", {}).items():
        p.sheet_templates[k] = SheetTemplate(**v)

    for k, v in data.get("sheets", {}).items():
        p.sheets[k] = Sheet(**v)

    for k, v in data.get("dimensions", {}).items():
        v = dict(v)

        if v.get("start"):
            v["start"] = Point(**v["start"])

        if v.get("end"):
            v["end"] = Point(**v["end"])

        p.dimensions[k] = Dimension(**v)

    for k, v in data.get("annotations", {}).items():
        p.annotations[k] = Annotation(**v)

    for k, v in data.get("schedules", {}).items():
        p.schedules[k] = Schedule(**v)

    for k, v in data.get("redlines", {}).items():
        p.redlines[k] = Redline(**v)

    for k, v in data.get("redline_resolutions", {}).items():
        p.redline_resolutions[k] = RedlineResolution(**v)

    for k, v in data.get("code_sources", {}).items():
        p.code_sources[k] = CodeSource(**v)

    for k, v in data.get("code_rules", {}).items():
        v = dict(v)
        v["severity"] = CodeSeverity(v["severity"])
        p.code_rules[k] = CodeRule(**v)

    for k, v in data.get("code_checks", {}).items():
        p.code_checks[k] = CodeCheck(**v)

    return p


